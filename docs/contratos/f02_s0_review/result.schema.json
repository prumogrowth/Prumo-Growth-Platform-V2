{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "prumo.s0.f02.review.result/0.1-candidate",
  "title": "Candidate S0 review-request result; no ratification or execution capability",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema": {
      "const": "prumo.s0.f02.review.result/0.1-candidate"
    },
    "state": {
      "enum": [
        "RECORDED_REVIEW_ONLY",
        "REPLAY_REVIEW_ONLY",
        "CURRENT_REVIEW_ONLY",
        "WITHDRAWN_REVIEW_ONLY",
        "EXPIRED_REVIEW_ONLY",
        "INPUT_REJECTED",
        "DENIED",
        "STALE",
        "IDEMPOTENCY_CONFLICT",
        "REQUEST_EXPIRED",
        "REVIEW_REQUEST_NOT_FOUND",
        "CLOCK_RECHECK_REQUIRED",
        "UNAVAILABLE"
      ]
    },
    "review_ref": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "type": "string",
          "format": "uuid"
        }
      ]
    },
    "revision": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "type": "string",
          "pattern": "^[1-9][0-9]{0,9}$",
          "description": "PostgreSQL integer serialized as decimal string, 1..2147483647"
        }
      ]
    },
    "observed_at": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "type": "string",
          "format": "date-time"
        }
      ]
    },
    "request_sha256": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      ]
    },
    "expires_at": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "type": "string",
          "format": "date-time"
        }
      ]
    },
    "evidence_scope": {
      "const": "CFI_CONTEXT_ONLY_F02_EVIDENCE_PENDING"
    },
    "human_ratification": {
      "const": "NOT_IMPLEMENTED_CONTRACT_PENDING"
    },
    "send_authorized": {
      "const": false
    },
    "scheduling_authorized": {
      "const": false
    },
    "commercial_transition_authorized": {
      "const": false
    }
  },
  "required": [
    "schema",
    "state",
    "review_ref",
    "revision",
    "observed_at",
    "request_sha256",
    "expires_at",
    "evidence_scope",
    "human_ratification",
    "send_authorized",
    "scheduling_authorized",
    "commercial_transition_authorized"
  ]
}
