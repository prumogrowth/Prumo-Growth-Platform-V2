      "exact_command_fields": [
        "action",
        "target_id",
        "cargo",
        "manager_id",
        "expected_relationship_id",
        "idempotency_key"
      ],
      "expected_relationship_id": {
        "wire_type": "canonical decimal string",
        "min": "0",
        "max": "9223372036854775807",
        "number_input": "REJECTED"
      },
      "authority": "Director only, rechecked in SQL"
    },
    "POST /functions/v1/prumo-admin-i82/v1/i80": {
      "actions": [
        "INVENTORY",
        "PREVIEW",
        "APPLY"
      ],
      "exact_command_fields": [
        "action",
        "target_id",
        "cargo",
        "manager_id",
        "expected_sha256",
        "preview_id",
        "cursor",
        "limit",
        "idempotency_key"
      ],
      "authority": "Director only, preview session binding and CAS remain SQL authoritative"
    }
  },
  "response": {
    "exact_fields": [
      "version",
      "correlation_id",
      "state",
      "commit",
      "scope",
      "receipt"
    ],
    "scope": "ADMINISTRATIVE_ONLY",
    "correlation_id": "server-generated UUID",
    "commit_values": [
      "CONFIRMED",
      "NOT_ATTEMPTED",
      "REJECTED",
      "UNKNOWN"
    ],
    "states": [
      "APPLIED",
      "ALREADY_APPLIED",
      "INVENTORY",
      "READY",
      "BLOCKED",
      "INPUT_REJECTED",
      "DENIED",
      "STALE",
      "CONFLICT",
      "CONCURRENT_CHANGE",
      "EXPIRED",
      "BUSY",
      "UNAVAILABLE",
      "NOT_FOUND",
      "METHOD_NOT_ALLOWED"
    ],
    "receipt": "validated existing I79/I80 administrative receipt; null on error"
  },
  "recovery": {
    "automatic_mutation_retry": false,
    "network_timeout_means_rollback": false,
    "unknown_requires": "same command/idempotency key with live authority/session; current denial is not evidence of prior rollback",
